@@ -123,4 +71,101 @@ class ApiSseController extends ApiControllerBase {
     });
   }
 
+  /**
+   * Answers a hub notice with the islands this session has not seen.
+   *
+   * A builder subscribed to the Mercure hub fetches this on each notice. It
+   * runs one pass of the stream's loop for the caller's session, and wraps
+   * each island in an out-of-band swap to its own pane.
+   *
+   * @param \Drupal\display_builder\InstanceInterface $display_builder_instance
+   *   Display builder instance.
+   *
+   * @return \Symfony\Component\HttpFoundation\Response
+   *   The islands' out-of-band swaps, or an empty body when nothing is new.
+   *
+   * @see \Drupal\display_builder\MercureHub
+   */
+  public function refresh(InstanceInterface $display_builder_instance): Response {
+    $swaps = '';
+    foreach ($this->relay((string) $display_builder_instance->id(), $this->session->getId()) as $sse_target => $data) {
+      $swaps .= \sprintf('<div data-hx-swap-oob="innerHTML:#%s">%s</div>', $sse_target, $data);
+    }
+
+    return new Response($swaps, Response::HTTP_OK, [
+      'Content-Type' => 'text/html; charset=UTF-8',
+      'Cache-Control' => 'no-store',
+    ]);
+  }
+
+  /**
+   * Renders the islands a session needs after another session's change.
+   *
+   * @param string $builder_id
+   *   The display_builder_instance entity ID.
+   * @param string $sessionId
+   *   The session asking.
+   *
+   * @return string[]
+   *   Each updated island's content on one line, keyed by its pane's HTML ID.
+   *   Empty when there is nothing to relay to this session.
+   */
+  private function relay(string $builder_id, string $sessionId): array {
+    // Nothing to relay when there is no recorded change, when this session
+    // already has it on screen (its own htmx request answered it with
+    // out-of-band swaps), or when it is old enough that the builder has
+    // been refreshed by other means. A change recorded by a writer outside
+    // the htmx cycle - an AI agent, a queue worker - belongs to no session
+    // and is relayed to everyone, including whoever asked for it.
+    // Session ID handles different users, and the same user in different
+    // browsers. Not handled: several tabs, same user, same browser.
+    if (!$this->sseState->shouldRelay($this->sseState->readLatest($builder_id), $sessionId, $this::STALE)) {
+      return [];
+    }
+
+    // Reload the instance to ensure we get the builder's latest
+    // state.
+    $builder = $this->entityTypeManager()->getStorage('display_builder_instance')
+      ->loadUnchanged($builder_id);
+
+    if (!$builder instanceof InstanceInterface) {
+      return [];
+    }
+    $this->builder = $builder;
+
+    // Recompute islands regarding the current user.
+    // Use ON_HISTORY_CHANGE because it is the event where most islands are
+    // updated.
+    $event = $this->createEventWithEnabledIsland(
+      DisplayBuilderEvents::ON_HISTORY_CHANGE,
+      $builder->getSources(),
+      NULL,
+      NULL,
+    );
+
+    $islands = [];
+    foreach ($event->getResult() as $island_id => $result) {
+      // Do nothing if the island is not updated.
+      if (empty($result)) {
+        continue;
+      }
+
+      // Do nothing if the island is empty.
+      if (!isset($result['content'])) {
+        continue;
+      }
+
+      $sse_target = "island-{$builder->id()}-{$island_id}";
+      $data = $this->renderer->renderInIsolation($result['content']);
+
+      // Need to send the data back as one line.
+      // @see https://www.reddit.com/r/htmx/comments/1mjhzl1/comment/n7bdf0s
+      $data = \str_replace(["\r\n", "\r", "\n"], ' ', (string) $data);
+
+      $islands[$sse_target] = $data;
+    }
+
+    return $islands;
+  }
+
 }
diff --git a/src/MercureHub.php b/src/MercureHub.php
new file mode 100644
index 0000000..1aad380
--- /dev/null
+++ b/src/MercureHub.php
@@ -0,0 +1,293 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\display_builder;
+
+use Drupal\Core\Site\Settings;
+use Psr\Log\LoggerInterface;
+use Symfony\Component\HttpFoundation\Cookie;
+use Symfony\Component\Mercure\Hub;
+use Symfony\Component\Mercure\Jwt\Grant;
+use Symfony\Component\Mercure\Jwt\StaticTokenProvider;
+use Symfony\Component\Mercure\Jwt\WebTokenFactory;
+use Symfony\Component\Mercure\ProtocolVersion;
+use Symfony\Component\Mercure\Update;
+use Symfony\Component\Mercure\Exception\RuntimeException as MercureException;
+use Symfony\Contracts\HttpClient\HttpClientInterface;
+
+/**
+ * The Mercure hub that tells open builders an instance changed.
+ *
+ * With a hub, a change publishes an empty "changed" update on the instance's
+ * topic, and each open builder fetches its own islands from the refresh route.
+ * No PHP worker waits per open builder. Without a hub, the builder streams from
+ * the SSE route as before.
+ *
+ * The hub is named in settings.php:
+ *
+ * @code
+ * $settings['display_builder_mercure'] = [
+ *   'url' => 'https://example.com/.well-known/mercure',
+ *   'publisher_secret' => '...',
+ *   'subscriber_secret' => '...',
+ *   // Optional. Defaults to the hub's protocol 1.0 name over https, and to
+ *   // mercure_access_token over plain http.
+ *   'cookie_name' => '...',
+ * ];
+ * @endcode
+ *
+ * When that setting is absent, the hub a Drupack start serves is used, from
+ * DRUPACK_MERCURE_URL, DRUPACK_MERCURE_PUBLISHER_SECRET and
+ * DRUPACK_MERCURE_SUBSCRIBER_SECRET.
+ *
+ * Tokens follow Mercure protocol 1.0: the hub URL is both their issuer and
+ * their audience, and each grants one action on one instance's topic.
+ *
+ * @see \Drupal\display_builder\Controller\ApiSseController::refresh()
+ */
+final class MercureHub {
+
+  /**
+   * The settings.php key that names the hub.
+   */
+  public const string SETTING = 'display_builder_mercure';
+
+  /**
+   * The type of the update a change publishes.
+   */
+  public const string EVENT = 'changed';
+
+  /**
+   * The cookie name a hub served over plain http reads.
+   *
+   * Browsers drop a "__Secure-" cookie set over http, the protocol 1.0 default.
+   */
+  public const string HTTP_COOKIE_NAME = 'mercure_access_token';
+
+  /**
+   * The client and subject every token names. This module issues them all.
+   */
+  private const string CLIENT_ID = 'display_builder';
+
+  /**
+   * Seconds a publisher token stays valid. One publish uses it.
+   */
+  private const int PUBLISHER_TOKEN_LIFETIME = 60;
+
+  /**
+   * The hub settings, or NULL when no hub is configured.
+   *
+   * @var array{url: non-empty-string, publisher_secret: non-empty-string, subscriber_secret: non-empty-string, cookie_name: string}|null
+   */
+  private readonly ?array $hub;
+
+  /**
+   * Builds the service over a hub's settings.
+   *
+   * @param \Psr\Log\LoggerInterface $logger
+   *   Records a notice the hub refused.
+   * @param array|null $hub
+   *   The url, publisher_secret, subscriber_secret and optional cookie_name of
+   *   the hub, or NULL for no hub.
+   * @param \Symfony\Contracts\HttpClient\HttpClientInterface|null $httpClient
+   *   The client that publishes, or NULL for Symfony's default one.
+   */
+  public function __construct(
+    private readonly LoggerInterface $logger,
+    ?array $hub,
+    private readonly ?HttpClientInterface $httpClient = NULL,
+  ) {
+    $this->hub = $hub === NULL ? NULL : self::complete($hub);
+  }
+
+  /**
+   * Builds the service over the hub settings.php or Drupack names.
+   *
+   * @param \Psr\Log\LoggerInterface $logger
+   *   Records a notice the hub refused.
+   *
+   * @return self
+   *   The service, with or without a hub.
+   */
+  public static function fromSettings(LoggerInterface $logger): self {
+    return new self($logger, self::fromSettingsOrEnvironment());
+  }
+
+  /**
+   * Whether a hub is configured.
+   */
+  public function isConfigured(): bool {
+    return $this->hub !== NULL;
+  }
+
+  /**
+   * The topic of an instance.
+   *
+   * A URN rather than a URL: drush and a browser request build different
+   * absolute URLs for one route, and both must name the same topic.
+   *
+   * @param string $instance_id
+   *   The display_builder_instance entity ID.
+   *
+   * @return string
+   *   The topic.
+   */
+  public static function topic(string $instance_id): string {
+    return 'urn:display-builder:instance:' . $instance_id;
+  }
+
+  /**
+   * Tells every open builder of an instance that it changed.
+   *
+   * A hub that does not answer loses the notice and fails nothing: the change
+   * is saved, and the next notice or reload shows it.
+   *
+   * @param string $instance_id
+   *   The display_builder_instance entity ID.
+   */
+  public function publishChanged(string $instance_id): void {
+    if ($this->hub === NULL) {
+      return;
+    }
+    $topic = self::topic($instance_id);
+    $token = $this->token($this->hub['publisher_secret'], Grant::ACTION_PUBLISH, $topic, self::PUBLISHER_TOKEN_LIFETIME);
+    $hub = new Hub($this->hub['url'], new StaticTokenProvider($token), httpClient: $this->httpClient, protocolVersion: ProtocolVersion::V1);
+
+    try {
+      $hub->publish(new Update($topic, '', TRUE, type: self::EVENT));
+    }
+    // The hub is a separate service, reached over HTTP.
+    catch (MercureException $exception) {
+      $this->logger->warning('The Mercure hub refused the change notice for @instance: @message', [
+        '@instance' => $instance_id,
+        '@message' => $exception->getMessage(),
+      ]);
+    }
+  }
+
+  /**
+   * The hub URL that streams an instance's notices.
+   *
+   * @param string $instance_id
+   *   The display_builder_instance entity ID.
+   *
+   * @return string
+   *   The hub URL with the instance's topic as its match parameter.
+   */
+  public function subscribeUrl(string $instance_id): string {
+    \assert($this->hub !== NULL);
+
+    return $this->hub['url'] . '?' . \http_build_query(['match' => self::topic($instance_id)]);
+  }
+
+  /**
+   * The cookie that lets a browser subscribe to one instance's topic.
+   *
+   * EventSource sends cookies and no Authorization header, so the token rides
+   * in an HttpOnly cookie scoped to the hub's path.
+   *
+   * @param string $instance_id
+   *   The display_builder_instance entity ID.
+   * @param int $lifetime
+   *   Seconds the cookie and its token stay valid.
+   *
+   * @return \Symfony\Component\HttpFoundation\Cookie
+   *   The cookie.
+   */
+  public function subscriberCookie(string $instance_id, int $lifetime): Cookie {
+    \assert($this->hub !== NULL);
+    $token = $this->token($this->hub['subscriber_secret'], Grant::ACTION_SUBSCRIBE, self::topic($instance_id), $lifetime);
+    $url = \parse_url($this->hub['url']);
+
+    return Cookie::create(
+      $this->hub['cookie_name'],
+      $token,
+      \time() + $lifetime,
+      $url['path'] ?? '/',
+      NULL,
+      ($url['scheme'] ?? '') === 'https',
+      TRUE,
+      FALSE,
+      Cookie::SAMESITE_STRICT,
+    );
+  }
+
+  /**
+   * Signs a protocol 1.0 token for one action on one topic.
+   *
+   * @param non-empty-string $secret
+   *   The HS256 secret of the action.
+   * @param string $action
+   *   Grant::ACTION_PUBLISH or Grant::ACTION_SUBSCRIBE.
+   * @param string $topic
+   *   The topic the token grants.
+   * @param int $lifetime
+   *   Seconds the token stays valid.
+   *
+   * @return string
+   *   The token, in compact serialization.
+   */
+  private function token(string $secret, string $action, string $topic, int $lifetime): string {
+    \assert($this->hub !== NULL);
+
+    return WebTokenFactory::fromSecret($secret, jwtLifetime: $lifetime)->create(
+      [new Grant([$action], [$topic])],
+      [
+        'iss' => $this->hub['url'],
+        'aud' => $this->hub['url'],
+        'sub' => self::CLIENT_ID,
+        'client_id' => self::CLIENT_ID,
+      ],
+    );
+  }
+
+  /**
+   * Reads the hub from settings.php, or from a Drupack start's environment.
+   *
+   * @return array|null
+   *   The hub settings, or NULL when neither names a hub.
+   */
+  private static function fromSettingsOrEnvironment(): ?array {
+    $settings = Settings::get(self::SETTING);
+    if ($settings !== NULL) {
+      return $settings;
+    }
+    $environment = [
+      'url' => \getenv('DRUPACK_MERCURE_URL'),
+      'publisher_secret' => \getenv('DRUPACK_MERCURE_PUBLISHER_SECRET'),
+      'subscriber_secret' => \getenv('DRUPACK_MERCURE_SUBSCRIBER_SECRET'),
+    ];
+    // Drupack exports the three together, from a start that serves the hub.
+    return \in_array(FALSE, $environment, TRUE) ? NULL : $environment;
+  }
+
+  /**
+   * Checks a hub's settings and fills in its cookie name.
+   *
+   * @param array $hub
+   *   The hub settings.
+   *
+   * @return array{url: non-empty-string, publisher_secret: non-empty-string, subscriber_secret: non-empty-string, cookie_name: string}
+   *   The settings, with a cookie name.
+   *
+   * @throws \InvalidArgumentException
+   *   When a key is missing or empty.
+   */
+  private static function complete(array $hub): array {
+    $complete = [];
+    foreach (['url', 'publisher_secret', 'subscriber_secret'] as $key) {
+      $value = $hub[$key] ?? NULL;
+      if (!\is_string($value) || $value === '') {
+        throw new \InvalidArgumentException(\sprintf('The Mercure hub setting "%s" is missing.', $key));
+      }
+      $complete[$key] = $value;
+    }
+    $complete['cookie_name'] = (string) ($hub['cookie_name'] ?? (\str_starts_with($complete['url'], 'http://')
+      ? self::HTTP_COOKIE_NAME
+      : ProtocolVersion::V1->getDefaultCookieName()));
+
+    return $complete;
+  }
+
+}
